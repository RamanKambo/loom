    { "because": "a resource is listed or not", "keyword": "enum", "path": "/exposure", "instance": { "uri": "loom://guide/engineering", "purpose": "The engineering method.", "contents": "GuideResource", "scope": "server", "exposure": "hidden" } },
    { "because": "a resource is the same for every session or scoped to one", "keyword": "enum", "path": "/scope", "instance": { "uri": "loom://guide/engineering", "purpose": "The engineering method.", "contents": "GuideResource", "scope": "public", "exposure": "listed" } }

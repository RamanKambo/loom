{
  "definition": "CatalogueOperation",
  "valid": [
    {
      "id": "validate",
      "purpose": "Validate a model against every rule.",
      "prerequisites": ["an inline model document, or a governed workspace for 'workspace': true"],
      "effects": "none",
      "refusals": [{ "cause": "invalid-input", "when": "the model breaks the structural contract" }],
      "nextAction": { "action": "preview the change that clears a finding", "operation": "planChange" },
      "exposure": {
        "mcp": { "tool": "loom.validate", "input": "ValidateInput", "data": "ValidateData", "presence": ["model-or-workspace"], "examples": [{ "description": "Validate the workspace model.", "input": { "workspace": true } }] },
        "cli": "none",
        "reason": "The command line validates inside check."
      }
    },
    {
      "id": "describe",
      "purpose": "Describe what this build supports.",
      "prerequisites": [],
      "effects": "none",
      "refusals": [],
      "nextAction": { "action": "read the required context" },
      "exposure": {
        "mcp": { "tool": "loom.describe", "input": "DescribeInput", "data": "DescribeData", "presence": [], "examples": [] },
        "cli": { "command": "describe", "usage": ["describe [--detail summary|full] [--sections a,b]"], "examples": [{ "description": "The first page of the patch operations.", "command": "describe --detail full --sections patches" }] }
      }
    },
    {
      "id": "project",
      "purpose": "Project a model to one target.",
      "prerequisites": ["a model, inline or the workspace model"],
      "effects": "none",
      "dependsOnProfiles": true,
      "refusals": [{ "cause": "invalid-input", "when": "the model has error findings" }],
      "nextAction": { "action": "qualify the projected artifacts" },
      "exposure": {
        "mcp": { "tool": "loom.project", "input": "ProjectInput", "data": "ProjectData", "presence": ["model-or-workspace"], "examples": [] },
        "cli": "none",
        "reason": "The command line writes projections with write --out."
      }
    },
    {
      "id": "workspaceStatus",
      "purpose": "Report an open workspace's current revisions.",
      "prerequisites": ["a handle this session opened"],
      "effects": "reads",
      "refusals": [{ "cause": "unknown-handle", "when": "the workspaceId names no handle of this session" }],
      "nextAction": { "action": "close the handle" },
      "exposure": { "mcp": "none", "cli": "none", "reason": "Catalogued before it is advertised." },
      "agentTool": { "tool": "loom.workspace", "action": "status", "input": "WorkspaceInput", "data": "WorkspaceStatus", "presence": ["workspace-handle"], "examples": [{ "description": "Read the status of a handle.", "input": { "action": "status", "workspaceId": "ws_3f9a1c7d" } }] }
    }
  ],
  "invalid": [
    { "because": "a purpose is one sentence closed by a period", "keyword": "pattern", "path": "/purpose", "instance": { "id": "describe", "purpose": "describe what this build supports", "prerequisites": [], "effects": "none", "refusals": [], "nextAction": { "action": "read the context" }, "exposure": { "mcp": "none", "cli": "none", "reason": "Not exposed." } } },
    { "because": "a prerequisite is a clause without a closing period", "keyword": "pattern", "path": "/prerequisites/0", "instance": { "id": "describe", "purpose": "Describe this build.", "prerequisites": ["A governed workspace."], "effects": "none", "refusals": [], "nextAction": { "action": "read the context" }, "exposure": { "mcp": "none", "cli": "none", "reason": "Not exposed." } } },
    { "because": "an exposure is 'none' or names its interface", "keyword": "oneOf", "path": "/exposure/cli", "instance": { "id": "describe", "purpose": "Describe this build.", "prerequisites": [], "effects": "none", "refusals": [], "nextAction": { "action": "read the context" }, "exposure": { "mcp": "none", "cli": "hidden", "reason": "Not exposed." } } },
    { "because": "an unknown operation member is rejected", "keyword": "additionalProperties", "path": "", "instance": { "id": "describe", "purpose": "Describe this build.", "prerequisites": [], "effects": "none", "refusals": [], "nextAction": { "action": "read the context" }, "exposure": { "mcp": "none", "cli": "none", "reason": "Not exposed." }, "notes": "x" } },
    { "because": "whether an operation depends on the profiles is true or false", "keyword": "type", "path": "/dependsOnProfiles", "instance": { "id": "project", "purpose": "Project a model.", "prerequisites": [], "effects": "none", "dependsOnProfiles": "yes", "refusals": [], "nextAction": { "action": "qualify it" }, "exposure": { "mcp": "none", "cli": "none", "reason": "Not exposed." } } }

    { "because": "a context request names its target", "keyword": "required", "path": "", "instance": { "workspaceId": "ws_example", "budget": { "maxRecords": 5 } } },
    { "because": "an unknown member is rejected", "keyword": "additionalProperties", "path": "", "instance": { "workspaceId": "ws_example", "target": { "kind": "resume" }, "everything": true } }

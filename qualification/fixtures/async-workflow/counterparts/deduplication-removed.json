  "decisions": [
    {
      "id": "dec.cohost-workers",
      "revision": 1,
      "question": "Do the render worker and the notifier share a deployment unit?",
      "alternatives": [
        {
          "id": "shared",
          "description": "One container group runs both workers.",
          "consequences": "One scaling rule and one identity for both; a heavy render load can delay notifications."
        },
        {
          "id": "separate",
          "description": "Each worker has its own unit.",
          "consequences": "Two units to operate; independent scaling.",
          "rejectedBecause": "Notification volume does not justify a separate unit; process isolation separates render failures."
        }
      ],
      "criteria": [
        "Operating cost.",
        "Isolation of notification delivery from render failures."
      ],
      "basedOn": [
        {
          "kind": "workload",
          "id": "wl.month-end"
        },
        {
          "kind": "inventory",
          "id": "inv.container-platform"
        }
      ],
      "chosen": "shared",
      "tradeoffs": "Shared scaling in exchange for one fewer unit.",
      "rationale": "Month-end volume fits one container group with headroom.",
      "affects": [
        {
          "kind": "deploymentUnit",
          "id": "du.workers"
        }
      ],
      "authority": "team-statements",
      "status": "accepted"
    },
    {
      "id": "dec.replace-mailer",
      "revision": 1,
      "question": "Is the batch mailer kept for statement notifications?",
      "alternatives": [
        {
          "id": "replace",
          "description": "Use the platform notification service.",
          "consequences": "Delivery receipts become available; the notifier is rewritten against a new API."
        },
        {
          "id": "keep",
          "description": "Keep the batch mailer.",
          "consequences": "No change for the notifier.",
          "rejectedBecause": "The mailer is end-of-life and has no delivery receipts."
        }
      ],
      "criteria": [
        "Delivery receipts.",
        "Supported product."
      ],
      "basedOn": [
        {
          "kind": "inventory",
          "id": "inv.mailer"
        },
        {
          "kind": "inventory",
          "id": "inv.notification-service"
        },
        {
          "kind": "requirement",
          "id": "req.generate-statement"
        }
      ],
      "chosen": "replace",
      "rationale": "The notification service is supported and reports delivery.",
      "affects": [
        {
          "kind": "component",
          "id": "notifier"
        }
      ],
      "authority": "team-statements",
      "status": "proposed"
    }

{
  "version": 1,
  "systemProfile": {
    "kind": "distributed-system",
    "traits": [
      "asynchronous",
      "retrying",
      "event-driven",
      "multi-component"
    ]
  },
  "components": [
    {
      "id": "statements-api",
      "purpose": "Accepts statement generation requests and reports job status.",
      "responsibilities": [
        "Request validation.",
        "Job acceptance."
      ],
      "owner": "team-statements",
      "kind": "service",
      "implementations": [
        {
          "language": "typescript",
          "module": "@fixtures/statements-api"
        }
      ]
    },
    {
      "id": "render-worker",
      "purpose": "Renders statement documents for accepted jobs.",
      "responsibilities": [
        "Rendering.",
        "Archiving rendered statements."
      ],
      "owner": "team-statements",
      "kind": "worker",
      "implementations": [
        {
          "language": "csharp",
          "module": "Statements.Render"
        }
      ]
    },
    {
      "id": "notifier",
      "purpose": "Notifies account holders when a statement is ready.",
      "responsibilities": [
        "Notification delivery."
      ],
      "owner": "team-statements",
      "kind": "worker",
      "implementations": [
        {
          "language": "typescript",
          "module": "@fixtures/notifier"
        }
      ]
    },
    {
      "id": "statements-store",
      "purpose": "Stores statement jobs and their state.",
      "responsibilities": [
        "Job persistence.",
        "Job state transitions."
      ],
      "owner": "team-statements",
      "kind": "database",
      "implementations": [
        {
          "language": "sql",
          "module": "statements"
        }
      ]
    }
  ],
  "types": [
    {
      "id": "statement-job",
      "version": 1,
      "owner": "statements-store",
      "representation": "domain",
      "stateProperty": "status",
      "key": [
        "id"
      ],
      "properties": [
        {
          "name": "id",
          "kind": "uuid",
          "required": true,
          "nullable": false,
          "immutable": true,
          "origin": "system"
        },
        {
          "name": "accountId",
          "kind": "string",
          "required": true,
          "nullable": false,
          "immutable": true,
          "origin": "client",
          "bounds": {
            "minLength": 1,
            "maxLength": 32
          }
        },
        {
          "name": "period",
          "kind": "string",
          "required": true,
          "nullable": false,
          "immutable": true,
          "origin": "client",
          "bounds": {
            "minLength": 7,
            "maxLength": 7,
            "pattern": "^\\d{4}-\\d{2}$"
          }
        },
        {
          "name": "status",
          "kind": "enum",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "system",
          "enumValues": [
            "accepted",
            "rendering",
            "rendered",
            "failed",
            "cancelled"
          ],
          "unknownEnumPolicy": "reject"
        },
        {
          "name": "documentUri",
          "kind": "string",
          "required": false,
          "nullable": true,
          "immutable": false,
          "origin": "system",
          "bounds": {
            "maxLength": 2048
          },
          "default": {
            "policy": "none",
            "appliesOn": "read",
            "description": "Absent until the job is rendered."
          }
        }
      ]
    },
    {
      "id": "statement-request",
      "version": 1,
      "owner": "statements-api",
      "representation": "request",
      "visibility": "public",
      "properties": [
        {
          "name": "accountId",
          "kind": "string",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "client",
          "bounds": {
            "minLength": 1,
            "maxLength": 32
          }
        },
        {
          "name": "period",
          "kind": "string",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "client",
          "bounds": {
            "minLength": 7,
            "maxLength": 7,
            "pattern": "^\\d{4}-\\d{2}$"
          }
        }
      ]
    },
    {
      "id": "statement-accepted",
      "version": 1,
      "owner": "statements-api",
      "representation": "response",
      "visibility": "public",
      "properties": [
        {
          "name": "jobId",
          "kind": "uuid",
          "required": true,
          "nullable": false,
          "immutable": true,
          "origin": "system"
        },
        {
          "name": "status",
          "kind": "enum",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "system",
          "enumValues": [
            "accepted",
            "rendering",
            "rendered",
            "failed",
            "cancelled"
          ],
          "unknownEnumPolicy": "preserve"
        }
      ]
    },
    {
      "id": "render-command",
      "version": 1,
      "owner": "statements-api",
      "representation": "event",
      "properties": [
        {
          "name": "jobId",
          "kind": "uuid",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "system"
        },
        {
          "name": "accountId",
          "kind": "string",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "system",
          "bounds": {
            "maxLength": 32
          }
        },
        {
          "name": "period",
          "kind": "string",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "system",
          "bounds": {
            "maxLength": 7
          }
        }
      ]
    },
    {
      "id": "statement-result",
      "version": 1,
      "owner": "render-worker",
      "representation": "event",
      "properties": [
        {
          "name": "jobId",
          "kind": "uuid",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "system"
        },
        {
          "name": "status",
          "kind": "enum",
          "required": true,
          "nullable": false,
          "immutable": false,
          "origin": "system",
          "enumValues": [
            "rendered",
            "failed"
          ],
          "unknownEnumPolicy": "reject"
        },
        {
          "name": "documentUri",
          "kind": "string",
          "required": false,
          "nullable": true,
          "immutable": false,
          "origin": "system",
          "bounds": {
            "maxLength": 2048
          }
        }
      ]
    }
  ],
  "operations": [
    {
      "id": "statement.generate",
      "version": 1,
      "owner": "statements-api",
      "kind": "async-command",
      "request": "statement-request",
      "response": "statement-accepted",
      "result": "statement-result",
      "authority": {
        "permission": "statements.write",
        "scheme": "bearer"
      },
      "bindings": [
        {
          "transport": "http",
          "method": "POST",
          "path": "/statements",
          "requestMediaType": "application/json",
          "responses": [
            {
              "status": 202,
              "kind": "accepted",
              "type": "statement-accepted",
              "description": "The job is accepted; the result arrives as an event."
            },
            {
              "status": 400,
              "kind": "error",
              "description": "The request is invalid."
            },
            {
              "status": 409,
              "kind": "error",
              "description": "A job for the same account and period is already in flight."
            }
          ]
        }
      ],
      "errors": [
        {
          "code": "STATEMENT_INVALID",
          "status": 400,
          "retryable": false,
          "description": "A member is missing or malformed."
        },
        {
          "code": "STATEMENT_IN_FLIGHT",
          "status": 409,
          "retryable": false,
          "description": "A job for the same account and period is already in flight."
        }
      ],
      "invokes": [
        {
          "kind": "routine",
          "id": "statements.sp_accept_job"
        },
        {
          "kind": "mutation",
          "id": "job.accept"
        }
      ],
      "criteria": [
        "req.generate-statement.accepted",
        "req.generate-statement.no-resubmit"
      ],
      "scenarios": [
        "scn.accept-statement",
        "scn.timeout-after-commit"
      ],
      "enforcement": {
        "authorization": "statements-api",
        "validation": "statements-api",
        "persistence": "statements-store",
        "orchestration": "render-worker"
      },
      "idempotency": {
        "kind": "idempotency-key",
        "key": {
          "in": "header",
          "name": "Idempotency-Key"
        },
        "window": "PT24H",
        "repeatedRequest": "The original 202 response and job identity are returned; no second job is accepted."
      },
      "concurrency": {
        "control": "serialized",
        "onConflict": "A second request for the same account and period while a job is in flight returns 409 STATEMENT_IN_FLIGHT."
      },
      "transaction": {
        "boundary": "outbox",
        "compensation": "A job whose render command was not published is published again by the outbox relay."
      },
      "async": {
        "accepted": {
          "status": 202,
          "type": "statement-accepted"
        },
        "completion": {
          "result": "statement-result",
          "via": "event",
          "event": "statements.results"
        },
        "jobIdentity": "jobId",
        "timeout": {
          "after": "PT15M",
          "ambiguity": "A job that times out after it committed may still complete; consumers wait for the result event or query the job and never resubmit."
        },
        "cancellation": {
          "supported": true,
          "operation": "statement.cancel",
          "semantics": "Only an accepted job that has not started rendering can be cancelled."
        },
        "retry": {
          "owner": "provider",
          "policy": "The render worker retries a failed render up to three times with exponential backoff, then fails the job."
        },
        "partialFailure": "If rendering succeeds but the result event is not published, the outbox relay publishes it again; the notifier deduplicates by job identity."
      }
    },
    {
      "id": "statement.cancel",
      "version": 1,
      "owner": "statements-api",
      "kind": "command",
      "authority": {
        "permission": "statements.write",
        "scheme": "bearer"
      },
      "bindings": [
        {
          "transport": "http",
          "method": "POST",
          "path": "/statements/{jobId}/cancel",
          "parameters": [
            {
              "name": "jobId",
              "in": "path",
              "kind": "uuid",
              "required": true
            }
          ],
          "responses": [
            {
              "status": 200,
              "kind": "success",
              "description": "The job is cancelled."
            },
            {
              "status": 409,
              "kind": "error",
              "description": "The job has already started rendering."
            }
          ]
        }
      ],
      "errors": [
        {
          "code": "STATEMENT_NOT_CANCELLABLE",
          "status": 409,
          "retryable": false,
          "description": "The job has already started rendering."
        }
      ],
      "invokes": [
        {
          "kind": "mutation",
          "id": "job.cancel"
        }
      ],
      "criteria": [
        "req.cancel-statement.cancel",
        "req.cancel-statement.cancel-refused"
      ],
      "scenarios": [
        "scn.cancel-accepted",
        "scn.cancel-rendering"
      ],
      "enforcement": {
        "authorization": "statements-api",
        "validation": "statements-api",
        "persistence": "statements-store",
        "orchestration": "render-worker"
      },
      "idempotency": {
        "kind": "naturally-idempotent",
        "repeatedRequest": "Cancelling an already cancelled job returns 200 with no further effect."
      },
      "concurrency": {
        "control": "serialized",
        "onConflict": "A cancellation that races a render start returns 409 STATEMENT_NOT_CANCELLABLE."
      },
      "transaction": {
        "boundary": "none",
        "compensation": "A single row transition needs no compensation."
      }
    },
    {
      "id": "statement.status",
      "version": 1,
      "owner": "statements-api",
      "kind": "query",
      "response": "statement-accepted",
      "authority": {
        "permission": "statements.read",
        "scheme": "bearer"
      },
      "bindings": [
        {
          "transport": "http",
          "method": "GET",
          "path": "/statements/{jobId}",
          "parameters": [
            {
              "name": "jobId",
              "in": "path",
              "kind": "uuid",
              "required": true
            }
          ],
          "responses": [
            {
              "status": 200,
              "kind": "success",
              "type": "statement-accepted",
              "description": "The job and its status."
            },
            {
              "status": 404,
              "kind": "error",
              "description": "No job has this identity."
            }
          ]
        }
      ],
      "errors": [
        {
          "code": "STATEMENT_NOT_FOUND",
          "status": 404,
          "retryable": false,
          "description": "No job has this identity."
        }
      ]
    },
    {
      "id": "statement.render",
      "version": 1,
      "owner": "render-worker",
      "kind": "command",
      "request": "render-command",
      "authority": {
        "permission": "statements.render"
      },
      "bindings": [
        {
          "transport": "message",
          "channel": "statements.render-requests"
        }
      ],
      "invokes": [
        {
          "kind": "mutation",
          "id": "job.start-render"
        },
        {
          "kind": "routine",
          "id": "statements.sp_complete_job"
        },
        {
          "kind": "mutation",
          "id": "job.complete"
        },
        {
          "kind": "mutation",
          "id": "job.fail"
        }
      ],
      "criteria": [
        "req.generate-statement.single-render",
        "req.generate-statement.render-failure"
      ],
      "scenarios": [
        "scn.duplicate-delivery",
        "scn.render-failure"
      ],
      "enforcement": {
        "authorization": "render-worker",
        "validation": "render-worker",
        "persistence": "statements-store"
      },
      "idempotency": {
        "kind": "idempotency-key",
        "key": {
          "in": "body",
          "name": "jobId"
        },
        "window": "PT24H",
        "repeatedRequest": "A repeated delivery for a job that is already rendering or rendered is acknowledged without rendering again."
      },
      "concurrency": {
        "control": "serialized",
        "onConflict": "Deliveries for one job are processed one at a time through the job status transition."
      },
      "transaction": {
        "boundary": "saga",
        "compensation": "A failed render moves the job to failed; no document is published."
      }
    },
    {
      "id": "statement.notify",
      "version": 1,
      "owner": "notifier",
      "kind": "command",
      "request": "statement-result",
      "authority": {
        "permission": "statements.notify"
      },
      "bindings": [
        {
          "transport": "message",
          "channel": "statements.results"
        }
      ],
      "criteria": [
        "req.generate-statement.single-render"
      ],
      "scenarios": [
        "scn.duplicate-delivery"
      ],
      "enforcement": {
        "authorization": "notifier",
        "validation": "notifier"
      },
      "idempotency": {
        "kind": "idempotency-key",
        "key": {
          "in": "body",
          "name": "jobId"
        },
        "window": "P7D",
        "repeatedRequest": "A repeated result event for an already notified job sends no second notification."
      }
    }
  ],
  "routines": [
    {
      "id": "statements.sp_accept_job",
      "version": 1,
      "owner": "statements-store",
      "host": "sql-procedure",
      "parameterPassing": "positional",
      "params": [
        {
          "name": "p_account_id",
          "kind": "string",
          "bounds": {
            "maxLength": 32
          },
          "required": true,
          "nullable": false,
          "binds": "statement-job.accountId"
        },
        {
          "name": "p_period",
          "kind": "string",
          "bounds": {
            "maxLength": 7
          },
          "required": true,
          "nullable": false,
          "binds": "statement-job.period"
        }
      ],
      "resultSet": [
        {
          "name": "job_id",
          "kind": "uuid",
          "nullable": false,
          "binds": "statement-job.id"
        },
        {
          "name": "status",
          "kind": "enum",
          "enumValues": [
            "accepted",
            "rendering",
            "rendered",
            "failed",
            "cancelled"
          ],
          "nullable": false,
          "binds": "statement-job.status"
        }
      ],
      "performsMutations": [
        "job.accept"
      ],
      "writes": [
        {
          "storage": "statements.jobs",
          "columns": [
            "id",
            "account_id",
            "period",
            "status"
          ]
        }
      ],
      "transactionScope": [
        "statements.jobs"
      ],
      "authority": {
        "permission": "statements.write"
      }
    },
    {
      "id": "statements.sp_complete_job",
      "version": 1,
      "owner": "statements-store",
      "host": "sql-procedure",
      "parameterPassing": "positional",
      "params": [
        {
          "name": "p_job_id",
          "kind": "uuid",
          "required": true,
          "nullable": false,
          "binds": "statement-job.id"
        },
        {
          "name": "p_document_uri",
          "kind": "string",
          "bounds": {
            "maxLength": 2048
          },
          "required": true,
          "nullable": false,
          "binds": "statement-job.documentUri"
        }
      ],
      "resultSet": [
        {
          "name": "status",
          "kind": "enum",
          "enumValues": [
            "accepted",
            "rendering",
            "rendered",
            "failed",
            "cancelled"
          ],
          "nullable": false,
          "binds": "statement-job.status"
        }
      ],
      "performsMutations": [
        "job.complete"
      ],
      "writes": [
        {
          "storage": "statements.jobs",
          "columns": [
            "status",
            "document_uri"
          ]
        }
      ],
      "transactionScope": [
        "statements.jobs"
      ],
      "authority": {
        "permission": "statements.render"
      }
    }
  ],
  "mutations": [
    {
      "id": "job.accept",
      "type": "statement-job",
      "owner": "statements-store",
      "from": [
        "$absent"
      ],
      "to": "accepted",
      "writes": [
        "id",
        "accountId",
        "period",
        "status"
      ],
      "guard": {
        "form": "prose",
        "text": "The account exists and no job for the same account and period is in flight."
      },
      "effect": "An accepted job exists for the account and period.",
      "requirements": [
        "req.generate-statement"
      ],
      "criteria": [
        "req.generate-statement.accepted"
      ],
      "scenarios": [
        "scn.accept-statement"
      ]
    },
    {
      "id": "job.start-render",
      "type": "statement-job",
      "owner": "statements-store",
      "from": [
        "accepted"
      ],
      "to": "rendering",
      "writes": [
        "status"
      ],
      "guard": {
        "form": "expression",
        "profile": "loom-predicate-1",
        "expression": {
          "op": "eq",
          "left": {
            "property": "status"
          },
          "right": {
            "literal": "accepted"
          }
        }
      },
      "effect": "The job is being rendered.",
      "requirements": [
        "req.generate-statement"
      ],
      "criteria": [
        "req.generate-statement.single-render"
      ],
      "scenarios": [
        "scn.duplicate-delivery"
      ]
    },
    {
      "id": "job.complete",
      "type": "statement-job",
      "owner": "statements-store",
      "from": [
        "rendering"
      ],
      "to": "rendered",
      "writes": [
        "status",
        "documentUri"
      ],
      "guard": {
        "form": "expression",
        "profile": "loom-predicate-1",
        "expression": {
          "op": "eq",
          "left": {
            "property": "status"
          },
          "right": {
            "literal": "rendering"
          }
        }
      },
      "effect": "The rendered document is recorded.",
      "requirements": [
        "req.generate-statement"
      ],
      "criteria": [
        "req.generate-statement.single-render"
      ],
      "scenarios": [
        "scn.duplicate-delivery"
      ]
    },
    {
      "id": "job.fail",
      "type": "statement-job",
      "owner": "statements-store",
      "from": [
        "rendering"
      ],
      "to": "failed",
      "writes": [
        "status"
      ],
      "guard": {
        "form": "prose",
        "text": "Rendering failed after the last retry."
      },
      "effect": "The job is failed and no document is published.",
      "requirements": [
        "req.generate-statement"
      ],
      "criteria": [
        "req.generate-statement.render-failure"
      ],
      "scenarios": [
        "scn.render-failure"
      ]
    },
    {
      "id": "job.cancel",
      "type": "statement-job",
      "owner": "statements-store",
      "from": [
        "accepted"
      ],
      "to": "cancelled",
      "writes": [
        "status"
      ],
      "guard": {
        "form": "expression",
        "profile": "loom-predicate-1",
        "expression": {
          "op": "eq",
          "left": {
            "property": "status"
          },
          "right": {
            "literal": "accepted"
          }
        }
      },
      "effect": "The job is cancelled before rendering starts.",
      "requirements": [
        "req.cancel-statement"
      ],
      "criteria": [
        "req.cancel-statement.cancel"
      ],
      "scenarios": [
        "scn.cancel-accepted",
        "scn.cancel-rendering"
      ]
    }
  ],
  "workflows": [],
  "edges": [
    {
      "from": "render-worker",
      "to": "statements-api",
      "kind": "integration",
      "rationale": "The worker consumes render commands the API publishes.",
      "readiness": {
        "claim": "contract",
        "maturity": "accepted",
        "substitutes": [
          {
            "kind": "fixture",
            "permits": [
              "implementation"
            ],
            "limits": "A recorded render-command fixture never satisfies the message integration obligation."
          }
        ],
        "evidence": [
          "integration"
        ]
      }
    },
    {
      "from": "notifier",
      "to": "render-worker",
      "kind": "runtime",
      "rationale": "The notifier consumes result events."
    },
    {
      "from": "statements-api",
      "to": "statements-store",
      "kind": "runtime",
      "rationale": "The API accepts jobs through the store procedures."
    },
    {
      "from": "render-worker",
      "to": "statements-store",
      "kind": "runtime",
      "rationale": "The worker records job transitions in the store."
    }
  ],
  "requirements": [
    {
      "id": "req.generate-statement",
      "revision": 1,
      "outcome": "An account holder can request a monthly statement and is notified when it is ready.",
      "owner": "team-statements",
      "scope": [
        "statements-api",
        "render-worker",
        "notifier",
        "statements-store"
      ],
      "source": [
        {
          "kind": "document",
          "ref": "statements-requirements",
          "revision": "4"
        }
      ],
      "basis": "sourced",
      "priority": "must",
      "status": "active",
      "criteria": [
        {
          "id": "req.generate-statement.accepted",

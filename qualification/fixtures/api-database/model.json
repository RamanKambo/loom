  "assumptions": [],
  "unknowns": [],
  "decisions": [
    {
      "id": "dec.currency-backfill",
      "revision": 1,
      "question": "Which currency do invoices created before contract version 2 receive?",
      "alternatives": [
        {
          "id": "eur",
          "description": "Backfill EUR.",
          "consequences": "Old invoices satisfy the NOT NULL column."
        },
        {
          "id": "nullable",
          "description": "Keep the column nullable for old rows.",
          "consequences": "Every reader handles a missing currency.",
          "rejectedBecause": "Version 2 readers require a currency."
        }
      ],
      "criteria": [
        "Every stored invoice has a currency."
      ],
      "basedOn": [
        {
          "kind": "observation",
          "id": "obs.single-currency"
        },
        {
          "kind": "requirement",
          "id": "req.create-invoice"
        }
      ],
      "chosen": "eur",
      "rationale": "The observation shows a single historical currency.",
      "affects": [
        {
          "kind": "migration",
          "id": "mig.invoice-currency"
        }
      ],
      "authority": "team-invoicing",
      "status": "proposed"
    }
  ],

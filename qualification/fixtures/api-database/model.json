        "req.create-invoice.currency-required"
      ],
      "kind": "failure",
      "when": "An invoice request without a currency is submitted.",
      "expected": "The request is rejected with status 400 and INVOICE_INVALID; no invoice exists.",
      "operations": [
        "invoice.submit"
      ]
    },
    {
      "id": "scn.invoice-payment",
      "requirements": [
        "req.invoice-payment"

  "mutations": [
    {
      "id": "invoice.create",
      "type": "invoice",
      "owner": "invoicing-store",
      "from": [
        "$absent"
      ],
      "to": "draft",
      "writes": [
        "id",
        "customerId",
        "amount",
        "currency",
        "status"
      ],
      "guard": {
        "form": "expression",
        "profile": "loom-predicate-1",
        "expression": {
          "op": "ge",
          "left": {
            "property": "amount"
          },
          "right": {
            "literal": 0
          }
        }
      },
      "effect": "A draft invoice exists for the customer.",
      "requirements": [
        "req.create-invoice"
      ],
      "criteria": [
        "req.create-invoice.created"
      ],
      "scenarios": [
        "scn.create-invoice"
      ]
    }

  "operations": [
    {
      "id": "invoice.submit",
      "version": 2,
      "owner": "invoicing-api",
      "kind": "command",
      "request": "invoice-request",
      "response": "invoice-response",
      "authority": {
        "permission": "invoice.write",
        "scheme": "oauth"
      },
      "bindings": [
        {
          "transport": "http",
          "method": "POST",
          "path": "/invoices",
          "responses": [
            {
              "status": 201,
              "kind": "success",
              "type": "invoice-response",
              "description": "The invoice was created as a draft."
            },
            {
              "status": 400,
              "kind": "error",
              "description": "The request is invalid."
            }
          ],
          "requestMediaType": "application/json"
        }
      ],
      "errors": [
        {
          "code": "INVOICE_INVALID",
          "status": 400,
          "retryable": false,
          "description": "A member is missing or out of range."
        }
      ],
      "invokes": [
        {
          "kind": "routine",
          "id": "invoicing.sp_create_invoice"
        },
        {
          "kind": "mutation",
          "id": "invoice.create"
        }
      ],
      "criteria": [
        "req.create-invoice.created",
        "req.create-invoice.currency-required"
      ],
      "scenarios": [
        "scn.create-invoice",
        "scn.reject-missing-currency"
      ],
      "enforcement": {
        "authorization": "invoicing-api",
        "validation": "invoicing-api",
        "persistence": "invoicing-store"
      },
      "idempotency": {
        "kind": "idempotency-key",
        "key": {
          "in": "header",
          "name": "Idempotency-Key"
        },
        "window": "P1D",
        "repeatedRequest": "The original response is returned and no second invoice is created."
      },
      "concurrency": {
        "control": "none",
        "onConflict": "Creation of a new invoice cannot conflict with another writer."
      },
      "transaction": {
        "boundary": "single-routine",
        "routine": "invoicing.sp_create_invoice"
      }
    },
    {
      "id": "invoice.get",
      "version": 2,
      "owner": "invoicing-api",
      "kind": "query",
      "response": "invoice-response",
      "authority": {
        "permission": "invoice.read",
        "scheme": "oauth"
      },
      "bindings": [
        {
          "transport": "http",
          "method": "GET",
          "path": "/invoices/{id}",
          "responses": [
            {
              "status": 200,
              "kind": "success",
              "type": "invoice-response",
              "description": "The invoice."
            },
            {
              "status": 404,
              "kind": "error",
              "description": "No invoice has this identifier."
            }
          ],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "kind": "string",
              "required": true,
              "description": "Invoice identifier."
            }
          ]
        }
      ],
      "errors": [
        {
          "code": "INVOICE_NOT_FOUND",
          "status": 404,
          "retryable": false,
          "description": "No invoice has this identifier."
        }
      ]
    },
    {
      "id": "invoice.payment",
      "version": 1,
      "owner": "invoicing-api",
      "kind": "query",
      "response": "payments:payment",
      "authority": {
        "permission": "invoice.read",
        "scheme": "oauth"
      },
      "bindings": [
        {
          "transport": "http",
          "method": "GET",
          "path": "/invoices/{id}/payment",
          "responses": [
            {
              "status": 200,
              "kind": "success",
              "type": "payments:payment",
              "description": "The payment recorded for the invoice, in the payments contract shape."
            },
            {
              "status": 404,
              "kind": "error",
              "description": "The invoice has no recorded payment."
            }
          ],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "kind": "string",
              "required": true,
              "description": "Invoice identifier."
            }
          ]
        }
      ],
      "errors": [
        {
          "code": "PAYMENT_NOT_FOUND",
          "status": 404,
          "retryable": false,
          "description": "The invoice has no recorded payment."
        }
      ],
      "criteria": [
        "req.invoice-payment.payment-visible"
      ],
      "scenarios": [
        "scn.invoice-payment"
      ]
    }

  "scenarios": [
    {
      "id": "scn.create-invoice",
      "requirements": [
        "req.create-invoice"
      ],
      "criteria": [
        "req.create-invoice.created"
      ],
      "kind": "success",
      "given": "A customer with no invoices.",
      "when": "An invoice request for 120.00 EUR is submitted.",
      "expected": "A draft invoice exists and the response returns its identifier with status draft.",
      "operations": [
        "invoice.submit"
      ]
    },
    {
      "id": "scn.reject-missing-currency",
      "requirements": [

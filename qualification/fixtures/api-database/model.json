  "observations": [
    {
      "id": "obs.single-currency",
      "claim": "Every invoice issued before contract version 2 was issued in EUR.",
      "about": [
        {
          "kind": "storage",
          "id": "invoicing.invoices"
        }
      ],
      "source": {
        "kind": "artifact",
        "ref": "billing-configuration-export",

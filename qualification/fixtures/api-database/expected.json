        "acceptance/current-contract.json"
      ],
      "expect": {
        "validation": "valid",
        "qualification": null,
        "mustInclude": [
          "PUBLISHED_CONTRACT_UNRESOLVED"
        ],
        "readiness": [
          {
            "task": {
              "class": "implementation",
              "mode": "component",
              "components": [
                "invoicing-api"
              ]
            },
            "state": "unresolved",
            "mustIncludeReasons": [
              "PUBLISHED_CONTRACT_UNRESOLVED"
            ]
          }
        ]
      }
    },
    {

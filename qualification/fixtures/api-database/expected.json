{
  "cases": [
    {
      "id": "coexisting-versions-with-pinned-published-contract",
      "description": "Response version 2 is current, version 1 stays supported for an active required consumer, the payments contract is pinned and resolved, and the storage keeps exact decimals.",
      "model": "model.json",
      "policy": "policy.json",
      "acceptance": [
        "acceptance/current-contract.json"
      ],
      "publishedBundles": [
        "published/payments-api@2.json"
      ],
      "expect": {
        "validation": "valid",
        "qualification": null,
        "mustInclude": [],
        "mustExclude": [
          "VERSION_BINDING_UNSUPPORTED",
          "VERSION_RETIREMENT_BLOCKED",
          "VERSION_SUPPORT_INVALID",
          "PUBLISHED_CONTRACT_DIGEST_MISMATCH",
          "PUBLISHED_CONTRACT_UNRESOLVED",
          "PUBLISHED_CONTRACT_REFERENCE_UNKNOWN",
          "STORAGE_COLUMN_LOSSY",
          "STORAGE_COLUMN_TYPE_MISMATCH",
          "MIGRATION_MISSING",
          "OPERATION_SECURITY_UNDECLARED",
          "HTTP_PATH_PARAMETER_UNDECLARED"
        ],
        "readiness": [
          {
            "task": {
              "class": "implementation",
              "mode": "component",
              "components": [
                "invoicing-api"
              ]
            },
            "state": "ready",
            "mustIncludeReasons": []
          }
        ]
      }
    },
    {
      "id": "vertical-slice-across-api-and-database",
      "description": "A vertical slice for invoice creation spans the API and the store; its work package lists both components and carries the migration evidence obligation.",
      "model": "model.json",
      "policy": "policy.json",
      "acceptance": [
        "acceptance/current-contract.json"
      ],
      "publishedBundles": [
        "published/payments-api@2.json"
      ],
      "expect": {
        "validation": "valid",
        "qualification": null,
        "readiness": [
          {
            "task": {
              "class": "implementation",
              "mode": "slice",
              "requirements": [
                "req.create-invoice"
              ],
              "components": [
                "invoicing-api",
                "invoicing-store"
              ]
            },
            "state": "ready",
            "mustIncludeReasons": [],
            "workPackage": {
              "scopeIncludes": [
                "invoicing-api",
                "invoicing-store"
              ],
              "exitEvidenceIncludes": [
                {
                  "claim": {
                    "kind": "migration",
                    "ref": "mig.invoice-currency"
                  },
                  "kinds": [
                    "migration"
                  ]
                },
                {
                  "claim": {
                    "kind": "criterion",
                    "ref": "req.create-invoice.created"
                  },
                  "kinds": [
                    "behavior",
                    "integration"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "unresolved-published-contract-blocks-dependent-work",
      "description": "The pinned payments contract was not resolved; plain validation reports it and work that depends on it is not ready.",
      "model": "model.json",
      "policy": "policy.json",

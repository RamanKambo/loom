    {
      "id": "migration-preserves-representative-rows",
      "description": "Applied to the version 1 table holding the representative rows, the authored migration yields the version 2 shape with every row preserved and currency EUR.",
      "model": "model.json",
      "baseline": "baseline/model.json",
      "expect": {
        "validation": "valid",
        "qualification": null,
        "checks": [
          {
            "id": "sql.migration",
            "result": "PASS",
            "inputs": {
              "previousModel": "baseline/model.json",
              "rows": "migrations/representative-rows-version-1.sql",
              "migration": "mig.invoice-currency"
            },
            "afterwards": {
              "rows": 3,
              "currency": "EUR",
              "amounts": [
                "120.00",
                "0.00",
                "9999999999.99"
              ]
            }
          }
        ]

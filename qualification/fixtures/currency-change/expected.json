  "cases": [
    {
      "id": "add-optional-currency-without-inferred-default",
      "description": "The optional currency is added with a source but without defaulting semantics; no default is inferred, the missing default is reported, the column is an exact string type and the consumers are named.",
      "baseline": "baseline/model.json",
      "patches": "steps/01-add-optional-currency.json",
      "model": "states/after-01.json",
      "policy": "policy.json",
      "expect": {
        "validation": "invalid",
        "qualification": null,
        "mustInclude": [
          "CONCERN_UNRESOLVED"
        ],
        "mustIncludeFindings": [
          {
            "code": "CONCERN_UNRESOLVED",
            "ref": {
              "kind": "property",
              "id": "order.currency"
            },
            "concern": "property.default"
          }
        ],
        "mustExclude": [
          "STORAGE_COLUMN_LOSSY",
          "STORAGE_COLUMN_TYPE_MISMATCH",
          "MAPPING_FIELD_UNKNOWN"
        ],
        "stateAssertions": [
          {
            "record": {
              "kind": "property",
              "id": "order.currency"
            },
            "absent": [
              "default"
            ]
          },
          {
            "record": {
              "kind": "storage",
              "id": "orders.orders"
            },
            "column": "currency",
            "absent": [
              "default"
            ]
          }
        ],
        "changes": {
          "kinds": [
            "compatible"
          ],
          "dimensionsAnyOf": [
            "shape-provider",
            "shape-consumer",
            "storage"
          ],
          "affectedInclude": [
            {
              "kind": "component",
              "id": "storefront"
            }
          ]
        }
      }
    },
    {
      "id": "default-recorded-as-unknown-blocks-release-only",
      "description": "A typed unknown stands in for the default; the concern is no longer unresolved, release is blocked by the unknown and implementation is not.",
      "baseline": "baseline/model.json",
      "patches": "steps/02-record-default-unknown.json",
      "model": "states/after-02.json",
      "policy": "policy.json",
      "expect": {
        "validation": "valid",
        "qualification": null,
        "mustInclude": [
          "UNKNOWN_OPEN"
        ],
        "mustExclude": [
          "CONCERN_UNRESOLVED"
        ],
        "readiness": [
          {
            "task": {
              "class": "release",
              "mode": "component",
              "components": [
                "orders-api",
                "orders-store"
              ]
            },
            "state": "blocked",
            "mustIncludeReasons": [
              "READINESS_BLOCKED_BY_UNKNOWN"
            ]
          },
          {
            "task": {
              "class": "implementation",
              "mode": "component",
              "components": [
                "orders-api"
              ]
            },
            "mustExcludeReasons": [
              "READINESS_BLOCKED_BY_UNKNOWN"
            ]
          }
        ]
      }
    },

{
  "name": "loom-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Loom: a schema-driven systems-engineering model. One portable JSON model is the single source of truth; every artifact is projected from it; mutations cascade and are rejected with precise errors unless the model stays valid.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/workspace",
    "packages/qualification",
    "packages/cli",
    "packages/mcp-server"
  ],
  "scripts": {
    "generate": "node packages/core/scripts/generate.mjs",
    "build": "node packages/core/scripts/generate.mjs --check && tsc -b",
    "clean": "tsc -b --clean",
    "self-test": "node packages/cli/dist/index.js --self-test",
    "test:workspace": "node --test \"packages/workspace/dist/test/*.test.js\"",
    "test:qualification": "node --test --test-concurrency=1 \"packages/qualification/dist/test/*.test.js\"",
    "smoke:mcp": "node packages/mcp-server/dist/smoke.js",
    "test:cli": "node --test --test-concurrency=1 \"packages/cli/dist/test/*.test.js\"",
    "test:mcp": "node --test --test-concurrency=1 \"packages/mcp-server/dist/test/*.test.js\"",
    "test:fixtures": "node --test --test-concurrency=1 \"packages/cli/dist/test/fixtures/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "4.10.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^5.9.3"
  }
}
